generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum SchoolStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum SessionUserType {
  PLATFORM_ADMIN
  OPERATOR
}

enum FileType {
  LOGO
  SIGNATURE
  STUDENT_PHOTO
  STUDENT_IMPORT
  STUDENT_IMPORT_ERROR
  TC
  RECEIPT
  REPORT_XLSX
}

enum FileStatus {
  AVAILABLE
  CORRUPT
}

enum JobType {
  TC_PDF
  REPORT_XLSX
  STUDENT_IMPORT_VALIDATE
  STUDENT_IMPORT_ERROR_EXPORT
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum TcStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum ResetRequestStatus {
  REQUESTED
  FULFILLED
  DISMISSED
}


model PlatformUser {
  id             String        @id @default(uuid()) @db.Uuid
  email          String        @unique @db.VarChar(255)
  fullName       String        @map("full_name") @db.VarChar(255)
  passwordHash   String        @map("password_hash") @db.VarChar(255)
  status         AccountStatus @default(ACTIVE)
  failedCount    Int           @default(0) @map("failed_count")
  lockedUntil    DateTime?     @map("locked_until") @db.Timestamptz(6)
  accountVersion Int           @default(1) @map("account_version")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@map("platform_users")
}

model School {
  id          String       @id @db.VarChar(36)
  name        String       @db.VarChar(255)
  normalizedName String    @map("normalized_name") @db.VarChar(255)
  address     String?      @db.Text
  phone       String?      @db.VarChar(32)
  email       String?      @db.VarChar(255)
  status      SchoolStatus @default(DRAFT)
  logoFileId  String?      @map("logo_file_id") @db.Uuid
  accessVersion Int        @default(1) @map("access_version")
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  principal   SchoolPrincipal?
  operators   SchoolOperator[]
  classes     Class[]
  sections    Section[]
  files       SchoolFile[]
  jobs        Job[]
  tcs         TransferCertificate[]
  students    Student[]
  enrollments StudentEnrollment[]
  importJobs  StudentImportJob[]
  @@index([normalizedName])
  @@index([status])
  @@map("schools")
}

model SchoolPrincipal {
  id              String   @id @default(uuid()) @db.Uuid
  schoolId        String   @unique @map("school_id") @db.VarChar(36)
  name            String   @db.VarChar(255)
  phone           String?  @db.VarChar(32)
  email           String?  @db.VarChar(255)
  signatureFileId String?  @map("signature_file_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  @@map("school_principals")
}

model SchoolOperator {
  id             String        @id @default(uuid()) @db.Uuid
  schoolId       String        @map("school_id") @db.VarChar(36)
  email          String        @unique @db.VarChar(255)
  fullName       String        @map("full_name") @db.VarChar(255)
  passwordHash   String        @map("password_hash") @db.VarChar(255)
  status         AccountStatus @default(ACTIVE)
  failedCount    Int           @default(0) @map("failed_count")
  lockedUntil    DateTime?     @map("locked_until") @db.Timestamptz(6)
  accountVersion Int           @default(1) @map("account_version")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  resetRequests  PasswordResetRequest[]
  @@index([schoolId, status])
  @@map("school_operators")
}

model Class {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.VarChar(36)
  name           String       @db.VarChar(64)
  normalizedName String       @map("normalized_name") @db.VarChar(64)
  sortOrder      Int          @default(0) @map("sort_order")
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  sections       Section[]
  enrollments    StudentEnrollment[]
  @@unique([schoolId, normalizedName])
  @@unique([schoolId, id])
  @@index([schoolId, status, sortOrder])
  @@map("classes")
}

model Section {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.VarChar(36)
  classId        String       @map("class_id") @db.Uuid
  name           String       @db.VarChar(64)
  normalizedName String       @map("normalized_name") @db.VarChar(64)
  sortOrder      Int          @default(0) @map("sort_order")
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  class          Class        @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Restrict)
  enrollments    StudentEnrollment[]
  @@unique([schoolId, classId, normalizedName])
  @@unique([schoolId, id])
  @@index([schoolId, classId, status, sortOrder])
  @@map("sections")
}

model UserSession {
  id               String          @id @default(uuid()) @db.Uuid
  userType         SessionUserType @map("user_type")
  userId           String          @map("user_id") @db.Uuid
  schoolId         String?         @map("school_id") @db.VarChar(36)
  tokenHash        String          @unique @map("token_hash") @db.VarChar(128)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt       DateTime        @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt        DateTime        @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?       @map("revoked_at") @db.Timestamptz(6)
  revocationReason String?         @map("revocation_reason") @db.VarChar(64)
  accountVersion   Int             @map("account_version")
  schoolAccessVersion Int?         @map("school_access_version")
  @@index([userType, userId, revokedAt])
  @@index([schoolId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model LoginAttempt {
  id             String          @id @default(uuid()) @db.Uuid
  userType       SessionUserType @map("user_type")
  identifierHash String          @map("identifier_hash") @db.VarChar(128)
  ipHash         String          @map("ip_hash") @db.VarChar(128)
  success        Boolean
  reason         String?         @db.VarChar(64)
  attemptedAt    DateTime        @default(now()) @map("attempted_at") @db.Timestamptz(6)
  @@index([userType, identifierHash, attemptedAt])
  @@index([ipHash, attemptedAt])
  @@map("login_attempts")
}

model PasswordResetRequest {
  id          String             @id @default(uuid()) @db.Uuid
  operatorId  String             @map("operator_id") @db.Uuid
  requestedAt DateTime           @default(now()) @map("requested_at") @db.Timestamptz(6)
  requestIpHash String           @map("request_ip_hash") @db.VarChar(128)
  status      ResetRequestStatus @default(REQUESTED)
  operator    SchoolOperator     @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  @@index([operatorId, requestedAt])
  @@map("password_reset_requests")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  requestId  String   @map("request_id") @db.VarChar(64)
  schoolId   String?  @map("school_id") @db.VarChar(36)
  actorType  String   @map("actor_type") @db.VarChar(32)
  actorId    String?  @map("actor_id") @db.Uuid
  eventType  String   @map("event_type") @db.VarChar(96)
  targetType String?  @map("target_type") @db.VarChar(64)
  targetId   String?  @map("target_id") @db.VarChar(128)
  metadata   Json?    @map("metadata_json") @db.JsonB
  ipHash     String?  @map("ip_hash") @db.VarChar(128)
  @@index([schoolId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([requestId])
  @@map("audit_logs")
}

model AuditOutbox {
  id         String   @id @default(uuid()) @db.Uuid
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  @@index([deliveredAt, createdAt])
  @@map("audit_outbox")
}

model SchoolFile {
  id        String     @id @default(uuid()) @db.Uuid
  schoolId  String     @map("school_id") @db.VarChar(36)
  fileType  FileType   @map("file_type")
  objectKey String     @unique @map("object_key") @db.VarChar(512)
  mime      String     @db.VarChar(128)
  sizeBytes Int        @map("size_bytes")
  sha256    String     @db.VarChar(64)
  status    FileStatus @default(AVAILABLE)
  createdBy String     @map("created_by") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  school    School     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  @@unique([schoolId, id])
  @@index([schoolId, fileType, status])
  @@map("school_files")
}

model Job {
  id             String    @id @default(uuid()) @db.Uuid
  schoolId       String?   @map("school_id") @db.VarChar(36)
  actorType      String    @map("actor_type") @db.VarChar(32)
  actorId        String    @map("actor_id") @db.Uuid
  jobType        JobType   @map("job_type")
  status         JobStatus @default(QUEUED)
  inputSnapshot  Json?     @map("input_snapshot_json") @db.JsonB
  inputEncrypted String?   @map("input_encrypted") @db.Text
  keyVersion     String?   @map("key_version") @db.VarChar(32)
  outputFileId   String?   @map("output_file_id") @db.Uuid
  attemptCount   Int       @default(0) @map("attempt_count")
  leaseUntil     DateTime? @map("lease_until") @db.Timestamptz(6)
  errorCode      String?   @map("error_code") @db.VarChar(96)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  school         School?   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  @@index([status, createdAt])
  @@index([schoolId, status])
  @@map("jobs")
}

model JobOutbox {
  id         String   @id @default(uuid()) @db.Uuid
  jobId      String   @unique @map("job_id") @db.Uuid
  queueName  String   @map("queue_name") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  attemptCount Int @default(0) @map("attempt_count")
  lastErrorCode String? @map("last_error_code") @db.VarChar(96)
  @@index([deliveredAt, createdAt])
  @@map("job_outbox")
}

model TransferCertificate {
  id                 String   @id @default(uuid()) @db.Uuid
  tcUuid             String   @unique @default(uuid()) @map("tc_uuid") @db.Uuid
  schoolId           String   @map("school_id") @db.VarChar(36)
  studentId          String   @map("student_id") @db.Uuid
  templateVersion    String   @map("template_version") @db.VarChar(64)
  snapshotCiphertext String   @map("snapshot_ciphertext") @db.Text
  snapshotIv         String   @map("snapshot_iv") @db.VarChar(64)
  snapshotTag        String   @map("snapshot_tag") @db.VarChar(64)
  keyVersion         String   @map("key_version") @db.VarChar(32)
  status             TcStatus @default(QUEUED)
  fileId             String?  @map("file_id") @db.Uuid
  jobId              String   @unique @map("job_id") @db.Uuid
  issuedBy           String   @map("issued_by") @db.Uuid
  issuedAt           DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)
  school             School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  @@index([schoolId, issuedAt])
  @@index([schoolId, studentId, issuedAt])
  @@map("transfer_certificates")
}

enum StudentGender {
  BOY
  GIRL
}

enum ConcessionType {
  NONE
  FIXED_AMOUNT
  PERCENTAGE
}

enum TransportSetupState {
  NOT_REQUIRED
  SETUP_PENDING
  ACTIVE
}

enum EnrollmentStatus {
  ACTIVE
  ENDED
}

enum ImportJobStatus {
  QUEUED
  VALIDATING
  READY
  IMPORTING
  COMPLETED
  PARTIAL
  FAILED
}

enum ImportRowStatus {
  PENDING
  VALID
  IMPORTED
  ERROR
}

model Student {
  id                  String              @id @default(uuid()) @db.Uuid
  schoolId            String              @map("school_id") @db.VarChar(36)
  studentCode         String              @map("student_code") @db.VarChar(64)
  normalizedCode      String              @map("normalized_code") @db.VarChar(64)
  fullName            String              @map("full_name") @db.VarChar(255)
  normalizedName      String              @map("normalized_name") @db.VarChar(255)
  fatherName          String              @map("father_name") @db.VarChar(255)
  motherName          String              @map("mother_name") @db.VarChar(255)
  familyCode          String?             @map("family_code") @db.VarChar(64)
  tallyLedgerName     String?             @map("tally_ledger_name") @db.VarChar(255)
  dob                 DateTime            @db.Date
  gender              StudentGender
  admissionDate       DateTime            @default(now()) @map("admission_date") @db.Date
  address             String              @db.Text
  phone               String              @db.VarChar(32)
  email               String?             @db.VarChar(255)
  emergencyContact    String              @map("emergency_contact") @db.VarChar(32)
  emergencyRelation   String              @map("emergency_relation") @db.VarChar(64)
  penNumber           String?             @map("pen_number") @db.VarChar(64)
  udiseCode           String?             @map("udise_code") @db.VarChar(64)
  previousSchool      String?             @map("previous_school") @db.VarChar(255)
  previousTcNumber    String?             @map("previous_tc_number") @db.VarChar(64)
  bloodGroup          String?             @map("blood_group") @db.VarChar(16)
  nationality         String              @default("Indian") @db.VarChar(64)
  hobbies             String?             @db.Text
  achievements        String?             @db.Text
  concessionType      ConcessionType      @default(NONE) @map("concession_type")
  concessionValue     Decimal             @default(0) @map("concession_value") @db.Decimal(12, 2)
  transportRequired   Boolean             @default(false) @map("transport_required")
  transportSetupState TransportSetupState @default(NOT_REQUIRED) @map("transport_setup_state")
  photoFileId         String?             @map("photo_file_id") @db.Uuid
  status              EntityStatus        @default(ACTIVE)
  deactivationReason  String?             @map("deactivation_reason") @db.Text
  version             Int                 @default(1)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  school              School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  privateProfile      StudentPrivateProfile?
  enrollments         StudentEnrollment[]
  identifierHistory   StudentIdentifierHistory[]

  @@unique([schoolId, normalizedCode])
  @@index([schoolId, status])
  @@index([schoolId, normalizedName])
  @@index([schoolId, familyCode])
  @@map("students")
}

model StudentPrivateProfile {
  id               String   @id @default(uuid()) @db.Uuid
  schoolId         String   @map("school_id") @db.VarChar(36)
  studentId        String   @unique @map("student_id") @db.Uuid
  encryptedPayload String   @map("encrypted_payload") @db.Text
  keyVersion       String   @default("v1") @map("key_version") @db.VarChar(32)
  aadhaarLast4     String   @map("aadhaar_last4") @db.VarChar(4)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_private_profiles")
}

model StudentEnrollment {
  id        String           @id @default(uuid()) @db.Uuid
  schoolId  String           @map("school_id") @db.VarChar(36)
  studentId String           @map("student_id") @db.Uuid
  classId   String           @map("class_id") @db.Uuid
  sectionId String           @map("section_id") @db.Uuid
  status    EnrollmentStatus @default(ACTIVE)
  startedAt DateTime         @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt   DateTime?        @map("ended_at") @db.Timestamptz(6)

  school    School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class            @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Restrict)
  section   Section          @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: Restrict)

  @@index([schoolId, studentId, status])
  @@index([schoolId, classId, sectionId, status])
  @@map("student_enrollments")
}

model StudentIdentifierHistory {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.VarChar(36)
  studentId String   @map("student_id") @db.Uuid
  oldCode   String   @map("old_code") @db.VarChar(64)
  newCode   String   @map("new_code") @db.VarChar(64)
  changedBy String   @map("changed_by") @db.Uuid
  reason    String   @db.Text
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, studentId, changedAt])
  @@map("student_identifier_history")
}

model StudentIdSequence {
  schoolId  String @id @map("school_id") @db.VarChar(36)
  lastValue Int    @default(0) @map("last_value")

  @@map("student_id_sequences")
}

model StudentImportJob {
  id           String           @id @default(uuid()) @db.Uuid
  schoolId     String           @map("school_id") @db.VarChar(36)
  operatorId   String           @map("operator_id") @db.Uuid
  fileId       String           @map("file_id") @db.Uuid
  errorFileId  String?          @map("error_file_id") @db.Uuid
  status       ImportJobStatus  @default(QUEUED)
  totalRows    Int              @default(0) @map("total_rows")
  validRows    Int              @default(0) @map("valid_rows")
  errorRows    Int              @default(0) @map("error_rows")
  importedRows Int              @default(0) @map("imported_rows")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  school       School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  rows         StudentImportRow[]

  @@index([schoolId, status, createdAt])
  @@map("student_import_jobs")
}

model StudentImportRow {
  id                String          @id @default(uuid()) @db.Uuid
  schoolId          String          @map("school_id") @db.VarChar(36)
  jobId             String          @map("job_id") @db.Uuid
  rowNumber         Int             @map("row_number")
  status            ImportRowStatus @default(PENDING)
  rawEncrypted      String          @map("raw_encrypted") @db.Text
  previewJson       Json            @map("preview_json") @db.JsonB
  errorMessages     Json?           @map("error_messages") @db.JsonB
  importedStudentId String?         @map("imported_student_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  job               StudentImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, rowNumber])
  @@index([schoolId, jobId, status])
  @@map("student_import_rows")
}
