generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(32)
  name      String   @db.VarChar(255)
  status    String   @default("ACTIVE") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users        User[]
  sessions     UserSession[]
  files        SchoolFile[]
  documentJobs DocumentJob[]
  exportJobs   ExportJob[]

  @@map("schools")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         String   @db.VarChar(32)
  schoolId     String?  @map("school_id") @db.Uuid
  status       String   @default("ACTIVE") @db.VarChar(32)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school       School?       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  sessions     UserSession[]
  filesUploaded SchoolFile[]

  @@index([schoolId])
  @@map("users")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  sessionTokenHash String    @unique @map("session_token_hash") @db.VarChar(128)
  userId           String    @map("user_id") @db.Uuid
  schoolId         String?   @map("school_id") @db.Uuid
  role             String    @db.VarChar(32)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  idleExpiresAt    DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  lastActiveAt     DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent        String?   @map("user_agent") @db.Text
  ipHash           String?   @map("ip_hash") @db.VarChar(64)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([schoolId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model LoginAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  identifier    String   @db.VarChar(255)
  ipAddress     String   @map("ip_address") @db.VarChar(64)
  attemptedAt   DateTime @default(now()) @map("attempted_at") @db.Timestamptz(6)
  success       Boolean  @default(false)
  failureReason String?  @map("failure_reason") @db.VarChar(128)

  @@index([identifier, attemptedAt])
  @@index([ipAddress, attemptedAt])
  @@map("login_attempts")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  requestId    String   @map("request_id") @db.VarChar(64)
  actorId      String?  @map("actor_id") @db.Uuid
  actorRole    String?  @map("actor_role") @db.VarChar(32)
  schoolId     String?  @map("school_id") @db.Uuid
  action       String   @db.VarChar(64)
  resourceType String   @map("resource_type") @db.VarChar(64)
  resourceId   String?  @map("resource_id") @db.VarChar(64)
  metadata     Json?    @db.JsonB
  ipHash       String?  @map("ip_hash") @db.VarChar(64)

  @@index([schoolId, occurredAt])
  @@index([action])
  @@index([requestId])
  @@map("audit_logs")
}

model SchoolFile {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  category      String   @db.VarChar(32)
  fileName      String   @map("file_name") @db.VarChar(255)
  fileSizeBytes Int      @map("file_size_bytes")
  mimeType      String   @map("mime_type") @db.VarChar(128)
  storageKey    String   @unique @map("storage_key") @db.VarChar(512)
  uploadedBy    String   @map("uploaded_by") @db.Uuid
  status        String   @default("ACTIVE") @db.VarChar(32)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  uploader User   @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([schoolId, category])
  @@map("school_files")
}

model DocumentJob {
  id              String    @id @default(uuid()) @db.Uuid
  schoolId        String    @map("school_id") @db.Uuid
  jobType         String    @map("job_type") @db.VarChar(64)
  status          String    @default("QUEUED") @db.VarChar(32)
  idempotencyKey  String?   @unique @map("idempotency_key") @db.VarChar(128)
  payloadSnapshot Json      @map("payload_snapshot") @db.JsonB
  fileId          String?   @map("file_id") @db.Uuid
  errorMessage    String?   @map("error_message") @db.Text
  enqueuedAt      DateTime  @default(now()) @map("enqueued_at") @db.Timestamptz(6)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@index([schoolId, status])
  @@map("document_jobs")
}

model ExportJob {
  id              String    @id @default(uuid()) @db.Uuid
  schoolId        String    @map("school_id") @db.Uuid
  exportType      String    @map("export_type") @db.VarChar(64)
  filterSnapshot  Json      @map("filter_snapshot") @db.JsonB
  status          String    @default("QUEUED") @db.VarChar(32)
  idempotencyKey  String?   @unique @map("idempotency_key") @db.VarChar(128)
  fileId          String?   @map("file_id") @db.Uuid
  errorMessage    String?   @map("error_message") @db.Text
  enqueuedAt      DateTime  @default(now()) @map("enqueued_at") @db.Timestamptz(6)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@index([schoolId, status])
  @@map("export_jobs")
}
