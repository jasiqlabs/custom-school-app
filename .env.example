NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
API_INTERNAL_URL=http://api:4000/api/v1
DATABASE_URL=postgresql://gdys:gdys@postgres:5432/gdys?schema=public
REDIS_URL=redis://redis:6379
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=gdys-private
COOKIE_SECURE=false
SESSION_HMAC_SECRET=replace-with-at-least-32-random-bytes
DUPLICATE_CONFIRMATION_SECRET=replace-with-at-least-32-random-bytes
DATA_ENCRYPTION_ACTIVE_VERSION=v1
DATA_ENCRYPTION_KEYS_JSON={"v1":"BASE64_32_BYTE_KEY"}
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
LOGIN_WINDOW_MINUTES=15
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=replace-before-seeding
