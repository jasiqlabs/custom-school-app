{
  "name": "custom-school-app-api",
  "version": "2.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "tsc -p ../../packages/storage/tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "test": "jest --runInBand",
    "seed:admin": "node dist/scripts/seed-admin.js",
    "seed:operator": "node dist/scripts/seed-operator.js"
  },
  "dependencies": {
    "@custom-school/contracts": "*",
    "@custom-school/validation": "*",
    "@nestjs/common": "^10.3.8",
    "@nestjs/core": "^10.3.8",
    "@nestjs/platform-express": "^10.3.8",
    "@prisma/client": "^5.14.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.11",
    "argon2": "^0.40.1",
    "bullmq": "^5.7.8",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "pino": "^9.0.0",
    "pino-http": "^9.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.1",
    "zod": "^3.23.8",
    "@custom-school/storage": "*",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "prisma": "^5.14.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
