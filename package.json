{
  "name": "get-digital-your-school",
  "version": "2.0.0",
  "private": true,
  "description": "Get Digital Your School — greenfield School ERP monorepo",
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "qa:static": "node scripts/static-qa.mjs",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "seed:admin": "npm --workspace apps/api run seed:admin"
  },
  "devDependencies": {
    "prisma": "^5.14.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
